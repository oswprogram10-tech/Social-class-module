rules_version = '2';

// 우리 동네 장소감 지도 - Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 파일 내용을 그대로 붙여넣고 "게시"를 누르세요.
//
// 원칙
//  - 모두 익명 로그인만 합니다 (이름·이메일을 받지 않음).
//  - 학급 정보는 학급 코드를 아는 사람만 열 수 있고(교사는 자기 학급 목록만), 학급을 만든 교사만 바꿀 수 있습니다.
//  - 학생은 자기 기록과, 교사가 공개한 친구 기록(공유 활동만)만 읽을 수 있습니다.
//  - 학생은 자기 핀만 고치거나 지울 수 있고, 승인·숨김은 교사만 바꿀 수 있습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function classData(code) {
      return get(/databases/$(database)/documents/classes/$(code)).data;
    }

    function isTeacher(code) {
      return signedIn() && classData(code).teacherUid == request.auth.uid;
    }

    function shortStr(v, max) {
      return v is string && v.size() <= max;
    }

    function optStr(d, key, max) {
      return !(key in d) || shortStr(d[key], max);
    }

    // 친구끼리 볼 수 있는 활동 (연표·미션·퀴즈형 기록은 본인과 교사만)
    function sharedActivities() {
      return ['feel', 'better', 'legend', 'solve', 'promote', 'heritage'];
    }

    function activities() {
      return ['feel', 'better', 'timeline', 'mission', 'legend', 'market', 'solve', 'promote', 'election', 'factcheck',
              'climate', 'population', 'history', 'globe', 'worldclimate', 'trade', 'worldpop', 'global', 'landform',
              'change', 'oldnew', 'heritage', 'democracy', 'villages', 'territory', 'rights', 'modern',
              'oldthings', 'exchange', 'powers', 'economy', 'growth',
              'prehistory', 'joseon', 'colonial',
              'perspective', 'continuity', 'heritagetypes', 'meeting', 'devmeeting', 'rivers',
              'rightswants', 'evidence', 'sources', 'peaceplaces', 'whichmap',
              'stats', 'industry'];
    }

    // 교사가 고친 생각 도우미 질문: 활동별 최대 5개
    function optQuestions(d) {
      return !('questions' in d) || (
        d.questions is map
        && d.questions.keys().hasOnly(activities())
        && (!('feel' in d.questions) || (d.questions.feel is list && d.questions.feel.size() <= 5))
        && (!('better' in d.questions) || (d.questions.better is list && d.questions.better.size() <= 5))
        && (!('mission' in d.questions) || (d.questions.mission is list && d.questions.mission.size() <= 5))
        && (!('solve' in d.questions) || (d.questions.solve is list && d.questions.solve.size() <= 5))
        && (!('timeline' in d.questions) || (d.questions.timeline is list && d.questions.timeline.size() <= 5))
        && (!('legend' in d.questions) || (d.questions.legend is list && d.questions.legend.size() <= 5))
        && (!('promote' in d.questions) || (d.questions.promote is list && d.questions.promote.size() <= 5))
        && (!('market' in d.questions) || (d.questions.market is list && d.questions.market.size() <= 5))
        && (!('election' in d.questions) || (d.questions.election is list && d.questions.election.size() <= 5))
        && (!('factcheck' in d.questions) || (d.questions.factcheck is list && d.questions.factcheck.size() <= 5))
        && (!('climate' in d.questions) || (d.questions.climate is list && d.questions.climate.size() <= 5))
        && (!('population' in d.questions) || (d.questions.population is list && d.questions.population.size() <= 5))
        && (!('history' in d.questions) || (d.questions.history is list && d.questions.history.size() <= 5))
        && (!('globe' in d.questions) || (d.questions.globe is list && d.questions.globe.size() <= 5))
        && (!('worldclimate' in d.questions) || (d.questions.worldclimate is list && d.questions.worldclimate.size() <= 5))
        && (!('trade' in d.questions) || (d.questions.trade is list && d.questions.trade.size() <= 5))
        && (!('worldpop' in d.questions) || (d.questions.worldpop is list && d.questions.worldpop.size() <= 5))
        && (!('global' in d.questions) || (d.questions.global is list && d.questions.global.size() <= 5))
        && (!('landform' in d.questions) || (d.questions.landform is list && d.questions.landform.size() <= 5))
        && (!('change' in d.questions) || (d.questions.change is list && d.questions.change.size() <= 5))
        && (!('oldnew' in d.questions) || (d.questions.oldnew is list && d.questions.oldnew.size() <= 5))
        && (!('heritage' in d.questions) || (d.questions.heritage is list && d.questions.heritage.size() <= 5))
        && (!('democracy' in d.questions) || (d.questions.democracy is list && d.questions.democracy.size() <= 5))
        && (!('villages' in d.questions) || (d.questions.villages is list && d.questions.villages.size() <= 5))
        && (!('territory' in d.questions) || (d.questions.territory is list && d.questions.territory.size() <= 5))
        && (!('rights' in d.questions) || (d.questions.rights is list && d.questions.rights.size() <= 5))
        && (!('modern' in d.questions) || (d.questions.modern is list && d.questions.modern.size() <= 5))
        && (!('perspective' in d.questions) || (d.questions.perspective is list && d.questions.perspective.size() <= 5))
        && (!('continuity' in d.questions) || (d.questions.continuity is list && d.questions.continuity.size() <= 5))
        && (!('heritagetypes' in d.questions) || (d.questions.heritagetypes is list && d.questions.heritagetypes.size() <= 5))
        && (!('meeting' in d.questions) || (d.questions.meeting is list && d.questions.meeting.size() <= 5))
        && (!('devmeeting' in d.questions) || (d.questions.devmeeting is list && d.questions.devmeeting.size() <= 5))
        && (!('rivers' in d.questions) || (d.questions.rivers is list && d.questions.rivers.size() <= 5))
        && (!('rightswants' in d.questions) || (d.questions.rightswants is list && d.questions.rightswants.size() <= 5))
        && (!('evidence' in d.questions) || (d.questions.evidence is list && d.questions.evidence.size() <= 5))
        && (!('sources' in d.questions) || (d.questions.sources is list && d.questions.sources.size() <= 5))
        && (!('peaceplaces' in d.questions) || (d.questions.peaceplaces is list && d.questions.peaceplaces.size() <= 5))
        && (!('whichmap' in d.questions) || (d.questions.whichmap is list && d.questions.whichmap.size() <= 5))
        && (!('stats' in d.questions) || (d.questions.stats is list && d.questions.stats.size() <= 5))
        && (!('industry' in d.questions) || (d.questions.industry is list && d.questions.industry.size() <= 5))
        && (!('oldthings' in d.questions) || (d.questions.oldthings is list && d.questions.oldthings.size() <= 5))
        && (!('exchange' in d.questions) || (d.questions.exchange is list && d.questions.exchange.size() <= 5))
        && (!('powers' in d.questions) || (d.questions.powers is list && d.questions.powers.size() <= 5))
        && (!('economy' in d.questions) || (d.questions.economy is list && d.questions.economy.size() <= 5))
        && (!('growth' in d.questions) || (d.questions.growth is list && d.questions.growth.size() <= 5))
        && (!('prehistory' in d.questions) || (d.questions.prehistory is list && d.questions.prehistory.size() <= 5))
        && (!('joseon' in d.questions) || (d.questions.joseon is list && d.questions.joseon.size() <= 5))
        && (!('colonial' in d.questions) || (d.questions.colonial is list && d.questions.colonial.size() <= 5)));
    }

    // 교사가 만든 팩트체크 자료: 최대 10개
    function optFactItems(d) {
      return !('factItems' in d) || (d.factItems is list && d.factItems.size() <= 10);
    }

    match /classes/{code} {
      allow get: if signedIn();
      // 교사가 자기 학급 목록만 볼 수 있음 (다른 기기에서 Google 로그인 후)
      allow list: if signedIn() && resource.data.teacherUid == request.auth.uid;

      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly([
             'code', 'name', 'schoolName', 'lat', 'lng', 'radius',
             'activeActivity', 'requireApproval', 'showOthers', 'teacherUid', 'createdAt', 'questions', 'factItems'])
        && request.resource.data.code == code
        && request.resource.data.teacherUid == request.auth.uid
        && shortStr(request.resource.data.name, 30)
        && shortStr(request.resource.data.schoolName, 30)
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.radius is number
        && request.resource.data.radius <= 5000
        && request.resource.data.activeActivity in activities()
        && request.resource.data.requireApproval is bool
        && request.resource.data.showOthers is bool
        && optQuestions(request.resource.data)
        && optFactItems(request.resource.data);

      allow update: if signedIn()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'radius', 'activeActivity', 'requireApproval', 'showOthers', 'questions', 'factItems'])
        && shortStr(request.resource.data.name, 30)
        && request.resource.data.activeActivity in activities()
        && request.resource.data.requireApproval is bool
        && request.resource.data.showOthers is bool
        && optQuestions(request.resource.data)
        && optFactItems(request.resource.data);

      allow delete: if signedIn() && resource.data.teacherUid == request.auth.uid;

      match /pins/{pinId} {

        function validPin(d) {
          return d.keys().hasOnly([
                   'activity', 'lat', 'lng', 'placeName', 'text', 'feeling', 'problem', 'fix',
                   'missionId', 'attempts',
                   'step', 'problemText', 'cause',
                   'optAType', 'optADetail', 'optAGood', 'optABad',
                   'optBType', 'optBDetail', 'optBGood', 'optBBad', 'chosen',
                   'category', 'slogan', 'placeType', 'symbol', 'year',
                   'itemId', 'labels', 'checks', 'trust', 'picks', 'giveUp',
                   'studentNo', 'nickname', 'authorUid', 'approved', 'hidden', 'likes', 'createdAt'])
            && d.activity in activities()
            && d.lat is number
            && d.lng is number
            && shortStr(d.placeName, 30)
            && shortStr(d.text, 150)
            && shortStr(d.nickname, 10)
            && d.studentNo is int
            && d.studentNo >= 1
            && d.studentNo <= 99
            && optStr(d, 'feeling', 20)
            && optStr(d, 'problem', 20)
            && optStr(d, 'fix', 20)
            && optStr(d, 'missionId', 20)
            && (!('attempts' in d) || (d.attempts is int && d.attempts >= 1))
            && (!('step' in d) || (d.step is int && d.step >= 1 && d.step <= 4))
            && optStr(d, 'problemText', 150)
            && optStr(d, 'cause', 150)
            && optStr(d, 'optAType', 20)
            && optStr(d, 'optADetail', 60)
            && optStr(d, 'optAGood', 80)
            && optStr(d, 'optABad', 80)
            && optStr(d, 'optBType', 20)
            && optStr(d, 'optBDetail', 60)
            && optStr(d, 'optBGood', 80)
            && optStr(d, 'optBBad', 80)
            && (!('chosen' in d) || d.chosen in ['A', 'B'])
            && optStr(d, 'category', 20)
            && optStr(d, 'slogan', 40)
            && optStr(d, 'placeType', 20)
            && optStr(d, 'symbol', 20)
            && (!('year' in d) || (d.year is int && d.year >= 1900 && d.year <= 2100))
            && optStr(d, 'itemId', 30)
            && optStr(d, 'labels', 40)
            && optStr(d, 'checks', 10)
            && (!('trust' in d) || d.trust in ['high', 'mid', 'low'])
            && optStr(d, 'picks', 120)
            && optStr(d, 'giveUp', 20)
            && d.approved is bool
            && d.hidden is bool
            && d.likes is int;
        }

        allow read: if isTeacher(code)
          || (signedIn() && resource.data.authorUid == request.auth.uid)
          || (signedIn()
              && resource.data.approved == true
              && resource.data.hidden == false
              && resource.data.activity in sharedActivities()
              && classData(code).showOthers == true);

        allow create: if signedIn()
          && validPin(request.resource.data)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.likes == 0
          && request.resource.data.hidden == false
          && request.resource.data.approved == !classData(code).requireApproval;

        allow update: if
          // 교사: 승인·숨김만 바꿀 수 있음
          (isTeacher(code)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'hidden'])
            && request.resource.data.approved is bool
            && request.resource.data.hidden is bool)
          // 작성한 학생: 내용만 고칠 수 있고, 승인은 "취소"만 가능
          || (signedIn()
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lat', 'lng', 'placeName', 'text', 'feeling', 'problem', 'fix', 'attempts',
                           'step', 'problemText', 'cause',
                           'optAType', 'optADetail', 'optAGood', 'optABad',
                           'optBType', 'optBDetail', 'optBGood', 'optBBad', 'chosen',
                           'category', 'slogan', 'placeType', 'symbol', 'year',
                           'labels', 'checks', 'trust', 'picks', 'giveUp', 'approved'])
            && (request.resource.data.approved == resource.data.approved
                || request.resource.data.approved == false)
            && validPin(request.resource.data))
          // 누구나: 공감 수를 1만 올릴 수 있음
          || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && request.resource.data.likes == resource.data.likes + 1);

        allow delete: if isTeacher(code)
          || (signedIn() && resource.data.authorUid == request.auth.uid);
      }
    }
  }
}
