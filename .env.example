# 다른 플랫폼에서 호스팅할 때 쓰는 설정 (docs/hosting.md)
# 이 파일을 .env.production 으로 복사해 값을 채운 뒤 npm run build 하세요.
# 비워 두면 체험 모드(기록이 각 브라우저에만 저장)로 빌드됩니다.

# Firebase 콘솔 → 프로젝트 설정 → 내 앱의 firebaseConfig 값
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# (선택) 브이월드 지도 키. 비우면 OpenStreetMap 지도를 씁니다.
VITE_VWORLD_KEY=

# (선택) 고칠 점·제안을 받을 GitHub 저장소 주소. 비우면 원래 저장소로 모입니다.
VITE_FEEDBACK_REPO=
